{
  "name": "xhs-mcp",
  "version": "0.1.0",
  "description": "MCP server for Xiaohongshu (RED): read your own notes and publish posts by driving a real local browser. No account password is stored.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "xiaohongshu",
    "xiaohongshu-mcp",
    "red",
    "playwright",
    "automation",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "zw-wang820",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zw-wang820/xhs-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/zw-wang820/xhs-mcp/issues"
  },
  "homepage": "https://github.com/zw-wang820/xhs-mcp#readme",
  "type": "module",
  "bin": {
    "xhs-mcp": "dist/bin.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "login": "tsx src/cli/login.ts",
    "capture": "tsx src/cli/capture.ts",
    "probe": "node scripts/probe.mjs",
    "smoke": "node scripts/smoke.mjs",
    "call": "node scripts/call.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "playwright": "^1.48.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
